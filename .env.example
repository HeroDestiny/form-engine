# Docker Compose Environment Variables
# Copie este arquivo para .env e preencha com valores seguros

# Laravel Application
APP_ENV=local
APP_DEBUG=false
APP_KEY=  # Generate with: docker-compose run --rm backend php artisan key:generate --show

# User/Group IDs (para permissões de arquivo)
USER_ID=1000
GROUP_ID=1000

# Database Configuration
DB_DATABASE=form_engine
DB_USERNAME=form_user
DB_PASSWORD=  # REQUIRED: Use senha forte (mínimo 16 caracteres, alfanumérico + símbolos)

# Redis Configuration
REDIS_PASSWORD=  # REQUIRED: Use senha forte (mínimo 16 caracteres, alfanumérico + símbolos)

# pgAdmin (apenas para desenvolvimento com --profile tools)
PGADMIN_EMAIL=admin@formengine.local
PGADMIN_PASSWORD=  # REQUIRED: Use senha forte (mínimo 12 caracteres)

# ========================================
# INSTRUÇÕES DE SEGURANÇA
# ========================================
# 1. NUNCA commite o arquivo .env no git
# 2. Use senhas únicas e fortes para cada serviço
# 3. Gere senhas com: openssl rand -base64 32
# 4. Para produção, use secrets management (Docker Secrets, Vault, etc)
# 5. Rotacione senhas regularmente
# 6. Mantenha este arquivo .env.example atualizado (sem valores reais)
